# Groq API 키 (https://console.groq.com/keys). LLM=ollama 이면 필요 없음
GROQ_API_KEY=
# 선택: 모델 바꾸기 (기본값은 아래와 같음)
# GROQ_MODEL_FAST=llama-3.1-8b-instant
# GROQ_MODEL_SMART=llama-3.3-70b-versatile
# 개발용 로컬 모델: LLM=ollama, OLLAMA_MODEL=설치한 모델 이름
LLM=
OLLAMA_MODEL=
# 도구가 읽을 수 있는 루트 (여러 개는 ; 로 구분)
ENVSCOUT_ROOTS=C:\project_job
# 감사 로그용 Neon 연결 문자열 (비워 두면 메모리에만 기록)
DATABASE_URL=
