# Groq API 키 (https://console.groq.com/keys). LLM=ollama 이면 필요 없음
GROQ_API_KEY=
# 선택: 모델 바꾸기 (기본값은 아래와 같음)
# GROQ_MODEL_FAST=llama-3.1-8b-instant
# GROQ_MODEL_SMART=llama-3.3-70b-versatile
# 개발용 로컬 모델: LLM=ollama, OLLAMA_MODEL=설치한 모델 이름 (OLLAMA_URL 기본 http://127.0.0.1:11434)
LLM=
OLLAMA_MODEL=
# 도구가 읽을 수 있는 루트. 여러 개는 Windows에서 ; , macOS·Linux에서 : 로 구분
ENVSCOUT_ROOTS=C:\project_job
# localhost 말고 접속을 허용할 주소 (쉼표로 구분, 예: http://mybox:3000). 비워 두면 로컬만
ENVSCOUT_ALLOWED_ORIGINS=
# 감사 로그용 Neon 연결 문자열 (비워 두면 메모리에만 기록)
DATABASE_URL=
# 감사 로그 보존 기간(일)
ENVSCOUT_LOG_RETENTION_DAYS=30
